RABBITMQ_URL=amqp://user:password@rabbit_host:5672/
RABBITMQ_QUEUE=events

ELASTICSEARCH_URL=https://es_host:9200/
ELASTICSEARCH_INDEX=events

ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=password

# leave empty to use password based authentication
ELASTICSEARCH_API_KEY=

DATABASE_URL=<user>:<password>@tcp(localhost)/<database>?parseTime=true
DB_DRIVER=mysql

# address the HTTP API listens on when running with -mode=api
API_ADDR=:8080